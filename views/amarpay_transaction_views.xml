<odoo>
    <!-- List view of amarpay.transaction -->
    <record id="amarpay_transaction_list_id" model="ir.ui.view">
        <field name="name">Transaction</field>
        <field name="model">amarpay.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="amount_total"/>
